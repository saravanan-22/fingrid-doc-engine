# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
# Base URL used in signing/audit links sent to signers
PUBLIC_BASE_URL=http://localhost:4000

# Document Engine Settings
TEMPLATES_DIR=./templates
OUTPUT_DIR=./generated_docs
GOTENBERG_URL=http://localhost:3000

# eSign Provider: MOCK | DIGIO | LEEGALITY | DOCUSIGN
ESIGN_PROVIDER=MOCK

# Where MOCK eSign sessions are saved so they survive restarts ("memory" = don't persist)
ESIGN_SESSION_STORE=./generated_docs/esign-sessions.json

# Digio Credentials (if ESIGN_PROVIDER=DIGIO)
DIGIO_CLIENT_ID=your_digio_client_id
DIGIO_CLIENT_SECRET=your_digio_client_secret
DIGIO_ENVIRONMENT=sandbox # sandbox | production

# Leegality Credentials (if ESIGN_PROVIDER=LEEGALITY)
LEEGALITY_AUTH_TOKEN=your_leegality_token
LEEGALITY_ENVIRONMENT=sandbox # sandbox | production

# DocuSign Credentials (if ESIGN_PROVIDER=DOCUSIGN)
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_CLIENT_ID=your_docusign_client_id
DOCUSIGN_CLIENT_SECRET=your_docusign_client_secret
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# Webhook Secrets
WEBHOOK_SIGNING_SECRET=fingrid_webhook_secret_dev_key
